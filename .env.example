# Copy to .env (used by docker-compose and as reference for any deployment)

# --- tenancy
APP_BASE_DOMAIN=localhost                 # prod: example.com  -> <slug>.example.com
APP_PLATFORM_DOMAIN=admin.localhost       # prod: admin.example.com (super-admin console)

# --- security (generate: openssl rand -base64 48)
JWT_SECRET=replace-me-with-at-least-32-random-bytes-0000000000
# AES key for secrets at rest (TOTP seeds): openssl rand -base64 32
APP_ENCRYPTION_KEY=
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe!123456
# Local compose runs over http: these two relax https-only defaults. Remove in production.
APP_SECURITY_OAUTH2_FRONTENDCALLBACK=http://{host}/auth/callback
CORS_ORIGINS=http://*.localhost

# --- database
DB_USER=boilerplate
DB_PASSWORD=boilerplate

# --- mail
MAIL_FROM=no-reply@example.com
APP_PRODUCT_NAME=Boilerplate

# --- OAuth2 social login (redirect URI: https://<host>/api/login/oauth2/code/<provider>)
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GITHUB_CLIENT_ID=change-me
GITHUB_CLIENT_SECRET=change-me
# Central callback host mode (one redirect URI for all tenants), see README:
# OAUTH2_REDIRECT_BASE=https://auth.example.com
# OAUTH2_COOKIE_DOMAIN=.example.com

# --- Sentry error reporting (leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Browser/SSR reporting for the Nuxt app (often a separate Sentry project)
NUXT_PUBLIC_SENTRY_DSN=
